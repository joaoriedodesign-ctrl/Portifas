{
  "color": {
    "paper": { "$type": "color", "$value": "#FFFFFF" },
    "surface": { "$type": "color", "$value": "#FBFAFA" },
    "border": { "$type": "color", "$value": "#D8D8D8" },
    "border-strong": { "$type": "color", "$value": "#C2B79E" },
    "ink": { "$type": "color", "$value": "#2C2C2C" },
    "ink-muted": { "$type": "color", "$value": "#676767" },
    "red": { "$type": "color", "$value": "#B8492F" },
    "red-hover": { "$type": "color", "$value": "#9C3D27" },
    "blue": { "$type": "color", "$value": "#35618F" },
    "blue-hover": { "$type": "color", "$value": "#2C4F76" },
    "yellow": { "$type": "color", "$value": "#D6A64A" },
    "yellow-hover": { "$type": "color", "$value": "#BE8F3B" }
  },
  "bg": {
    "page": { "$type": "color", "$value": "{color.paper}" },
    "surface": { "$type": "color", "$value": "{color.surface}" }
  },
  "border": {
    "default": { "$type": "color", "$value": "{color.border}" },
    "strong": { "$type": "color", "$value": "{color.border-strong}" }
  },
  "text": {
    "primary": { "$type": "color", "$value": "{color.ink}" },
    "secondary": { "$type": "color", "$value": "{color.ink-muted}" },
    "inverse": { "$type": "color", "$value": "{color.paper}" }
  },
  "brand": {
    "primary": { "$type": "color", "$value": "{color.red}" },
    "primary-hover": { "$type": "color", "$value": "{color.red-hover}" },
    "secondary": { "$type": "color", "$value": "{color.blue}" },
    "secondary-hover": { "$type": "color", "$value": "{color.blue-hover}" },
    "tertiary": { "$type": "color", "$value": "{color.yellow}" },
    "tertiary-hover": { "$type": "color", "$value": "{color.yellow-hover}" }
  }
}
